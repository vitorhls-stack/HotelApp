<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HotelApp.Models"
             x:Class="HotelApp.Views.Suites"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="10"
          RowSpacing="10">

        <Label Grid.Row="0"
               Text="Nossas Suítes"
               FontFamily="Rye"
               FontSize="40"
               TextColor="{StaticResource Primary}" />

        <CollectionView x:Name="cv_suites"
                        Grid.Row="1">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Quarto">
                    <Frame Margin="5" Padding="12">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Descricao}"
                                   TextTransform="Uppercase"
                                   FontSize="Subtitle"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding ValorDiariaAdulto, StringFormat='Adulto: R$ {0:N2} por diária'}" />
                            <Label Text="{Binding ValorDiariaCrianca, StringFormat='Criança: R$ {0:N2} por diária'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                Text="Voltar"
                HorizontalOptions="Center"
                Clicked="OnVoltarClicked" />
    </Grid>
</ContentPage>