<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelApp.Views.Inicio"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="20"
                         Spacing="15">

        <Image Source="dotnet_bot.png"
               HeightRequest="150"
               Aspect="AspectFit" />

        <Label Text="Hotel App"
               FontFamily="Rye"
               FontSize="44"
               TextColor="{StaticResource Primary}" />

        <Label Text="Bem-vindo! Reserve sua hospedagem com praticidade e conforto."
               FontSize="16"
               TextColor= "{StaticResource Black}" />   

        <Frame Padding="15">
            <VerticalStackLayout Spacing="12">
                <Button Text="Fazer Reserva"
                        Clicked="OnReservarClicked" />

                <Button Text="Nossas Suítes"
                        Clicked="OnSuitesClicked" />

                <Button Text="Sobre"
                        Clicked="OnSobreClicked" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>